PORT=5000
NODE_ENV=development

# PostgreSQL Veritabanı Bağlantısı (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skillswap_db?schema=public"

# JWT Yapılandırması
JWT_SECRET="super-secret-jwt-key-change-in-production-12345"
JWT_EXPIRES_IN="7d"

# Client URL (CORS ayarları için)
CLIENT_URL="http://localhost:3000"
